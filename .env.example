# Google Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs API Key (Get from https://elevenlabs.io/)
# If empty or quota exceeded, system automatically falls back to Edge-TTS!
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# YouTube Data API v3 (OAuth2 Client)
# You can generate this using scripts/setup_youtube_token.py
YOUTUBE_CLIENT_ID=your_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_client_secret
YOUTUBE_REFRESH_TOKEN=your_refresh_token

# Optional: Set to 'private', 'unlisted', or 'public'
YOUTUBE_PRIVACY_STATUS=public
